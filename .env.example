# Copy to .env and adjust. Every value has a default, so an empty .env works
# for local development: fake LLM, LM Studio on :1234 for embeddings, Qdrant
# on :6333. Variables are described in docs/DESIGN.md (Configuration).
# Never commit .env.

# --- Chat LLM (any OpenAI-compatible API) -----------------------------------
# fake = rule-based planner, no key and no model server needed.
LLM_DEFAULT=fake
# Local LM Studio:
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3.5-9b
# Cloud examples (set LLM_API_KEY to the provider's key; the model must support tool calling):
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4.1-mini
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=anthropic/claude-sonnet-5
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings for the knowledge base (OpenAI-compatible /embeddings) -------
# Empty base URL / key = reuse LLM_*. Changing the model rebuilds the collection.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-bge-m3
#   OpenAI: EMBED_BASE_URL=https://api.openai.com/v1  EMBED_MODEL=text-embedding-3-small

# --- RAGAS judge ---------------------------------------------------------------
# Empty = reuse LLM_*. A stronger model gives more stable scores.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
# json_schema works on LM Studio and OpenAI; use json or md_json otherwise.
JUDGE_JSON_MODE=json_schema

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Harness -------------------------------------------------------------------
DB_PATH=data/harness.db
LOG_LEVEL=INFO
# json = one JSON object per line; text = human-readable.
LOG_FORMAT=json
# Accept "faults" in run requests (demos and tests). Set false in any shared deployment.
ALLOW_FAULT_INJECTION=true
# When set, approval decisions over HTTP need the header X-Approver-Token.
APPROVER_TOKEN=
CORS_ORIGINS=http://localhost:4200
