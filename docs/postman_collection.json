              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "approvals",
                "{{approvalId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"edit\",\n  \"args\": {\n    \"title\": \"payments-api 5xx error spike\",\n    \"description\": \"Error rate above 5% since 10:40 UTC. Runbook followed, rollback pending.\",\n    \"severity\": \"SEV2\"\n  }\n}"
            },
            "description": "args replace the proposed arguments completely and are validated (422 if invalid)."
          },
          "event": []
        },
        {
          "name": "Decide twice (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Approver-Token",
