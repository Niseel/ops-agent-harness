                "{{approvalId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"reject\",\n  \"reason\": \"Known issue, already tracked in INC-1234.\"\n}"
            }
          },
          "event": []
        },
        {
          "name": "Edit, then run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Approver-Token",
                "value": "{{approverToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/approvals/{{approvalId}}",
              "host": [
