    {
      "name": "4. Approvals",
      "description": "Decisions on a pending create_incident call. Set approvalId first (List pending approvals). If APPROVER_TOKEN is set on the server, set the approverToken variable.",
      "item": [
        {
          "name": "List pending approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
