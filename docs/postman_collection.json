{
  "info": {
    "_postman_id": "5f0c0d4e-6a5b-4c1e-9d0a-0a11ce000001",
    "name": "Ops Agent Harness",
    "description": "Every route of the API (contract: specs/ops-agent-harness.md, API). Start with folder 1: it creates a run, approves the incident and checks the trace. Variables are set by the requests; only baseUrl (and approverToken when APPROVER_TOKEN is set) needs a value. To run everything with newman, add --timeout-request 30000; folder 1 alone is the acceptance check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "approverToken",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "approvalId",
      "value": ""
    },
    {
      "key": "pollLeft",
      "value": "40"
    }
  ],
  "item": [
    {
      "name": "1. Demo flow: create → approve → trace",
      "description": "Run this folder in order (Postman Runner or `npx newman run docs/postman_collection.json --folder \"1. Demo flow: create → approve → trace\"`). It needs the API running with the fake LLM and nothing else.",
      "item": [
        {
          "name": "Create run that asks for an incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objective\": \"payments-api is returning 5xx errors. Investigate and open an incident if needed.\",\n  \"llm\": \"fake\",\n  \"options\": {\n    \"evaluate\": false\n  }\n}"
            },
            "description": "Online evaluation is off so that the trace ends with the done event (evaluation events are written after done)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('returns run_id', function () { pm.expect(body.run_id).to.be.a('string'); });",
                  "pm.collectionVariables.set('runId', body.run_id);",
                  "pm.collectionVariables.set('pollLeft', 40);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait until the run needs approval",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 300);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.response.json();",
                  "const left = Number(pm.collectionVariables.get('pollLeft'));",
                  "if (!(run.status === 'awaiting_approval') && left > 0) {",
                  "  pm.collectionVariables.set('pollLeft', left - 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('pollLeft', 40);",
                  "  pm.test('run is awaiting_approval', function () { pm.expect(run.status === 'awaiting_approval').to.be.true; });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Find the pending approval",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/approvals?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "approvals"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const mine = pm.response.json().filter(a => a.run_id === pm.collectionVariables.get('runId'));",
                  "pm.test('one pending approval for create_incident', function () {",
                  "  pm.expect(mine).to.have.lengthOf(1);",
                  "  pm.expect(mine[0].tool).to.eql('create_incident');",
                  "});",
                  "pm.collectionVariables.set('approvalId', mine[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "No incident before the decision",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const mine = pm.response.json().filter(i => i.run_id === pm.collectionVariables.get('runId'));",
                  "pm.test('no incident yet', function () { pm.expect(mine).to.have.lengthOf(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Approver-Token",
                "value": "{{approverToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/approvals/{{approvalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "approvals",
                "{{approvalId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('approval is approved', function () { pm.expect(pm.response.json().status).to.eql('approved'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait until the run completes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 300);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.response.json();",
                  "const left = Number(pm.collectionVariables.get('pollLeft'));",
                  "if (!(run.status === 'completed') && left > 0) {",
                  "  pm.collectionVariables.set('pollLeft', left - 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('pollLeft', 40);",
                  "  pm.test('run is completed', function () { pm.expect(run.status === 'completed').to.be.true; });",
                  "  pm.test('usage recorded', function () { pm.expect(run.usage).to.have.keys('prompt_tokens', 'completion_tokens'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Exactly one incident",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const mine = pm.response.json().filter(i => i.run_id === pm.collectionVariables.get('runId'));",
                  "pm.test('one incident for this run', function () { pm.expect(mine).to.have.lengthOf(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Trace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/trace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "trace"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const events = pm.response.json().events;",
                  "pm.test('events in seq order', function () {",
                  "  const seqs = events.map(e => e.seq);",
                  "  pm.expect(seqs).to.eql([...seqs].sort((a, b) => a - b));",
                  "});",
                  "pm.test('ends with one done event', function () {",
                  "  pm.expect(events.filter(e => e.kind === 'done')).to.have.lengthOf(1);",
                  "  pm.expect(events[events.length - 1].kind).to.eql('done');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
