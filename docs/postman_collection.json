              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "approvals",
                "{{approvalId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}"
            },
            "description": "Send after any decision above: a second decision returns 409."
          },
          "event": []
        }
